@page
@model AppealsSystem.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Регистрация";
}

<div class="login-wrap">
    <div class="login-card">
        <div class="login-logo">АИС Обращений</div>
        <p class="login-sub">Создание нового аккаунта</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="form-group" style="text-align:left;">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" class="form-control" placeholder="citizen@appeals.local" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group" style="text-align:left;">
                <label asp-for="Input.Password">Пароль</label>
                <input asp-for="Input.Password" class="form-control" placeholder="минимум 6 символов" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group" style="text-align:left;">
                <label asp-for="Input.ConfirmPassword">Подтверждение пароля</label>
                <input asp-for="Input.ConfirmPassword" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn" style="width:100%; margin-top:1rem;">
                Зарегистрироваться
            </button>
        </form>

        <p class="text-muted mt-3" style="font-size:0.85rem;">
            Уже есть аккаунт?
            <a asp-page="./Login">Войти</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}