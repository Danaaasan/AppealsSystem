<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — АИС Обращения</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">АИС | Обращения</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Главная</a></li>

                    @if (User.IsInRole("Admin") || User.IsInRole("Specialist"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Appeals" asp-action="Dashboard">Дашборд</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Appeals" asp-action="Index">Все обращения</a></li>
                    }

                    @if (User.IsInRole("Executor"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Appeals" asp-action="Index">Все обращения</a></li>
                    }

                    @if (User.IsInRole("Citizen"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Appeals" asp-action="My">Мои обращения</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Appeals" asp-action="Create">Подать</a></li>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">Пользователи</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Audit">Аудит</a></li>
                    }

                    <partial name="_LoginPartial" />
                </ul>
            </div>
        </div>
    </nav>

    <main>@RenderBody()</main>

    <footer>
        <p>© 2026 АИС Обращений граждан</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>