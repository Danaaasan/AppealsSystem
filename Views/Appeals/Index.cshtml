@model List<AppealsSystem.Models.Appeal>
@{ ViewData["Title"] = "Обращения"; }
<div class="container py-4">
    <h1 class="fw-bold">Обращения граждан</h1>
    <p class="text-muted">Всего: @Model.Count</p>
    <div class="table-wrap">
        <table class="table table-hover">
            <thead>
                <tr><th>№</th><th>Дата</th><th>Заявитель</th><th>Тема</th><th>Срок</th><th>Статус</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var a in Model)
            {
                <tr>
                    <td>@a.RegistrationNumber</td>
                    <td>@a.CreatedAt.ToString("dd.MM.yyyy")</td>
                    <td>@a.Citizen?.FullName</td>
                    <td>@a.Subject</td>
                    <td>@a.Deadline.ToString("dd.MM.yyyy")</td>
                    <td><span class="badge badge-new">@a.Status</span></td>
                    <td><a asp-action="Details" asp-route-id="@a.Id" class="btn btn-sm btn-outline">Открыть</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>